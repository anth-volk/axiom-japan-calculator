{
  "name": "axiom-japan-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:manifest": "node scripts/generate-manifest.mjs",
    "build:policy": "scripts/build-policy-artifacts.sh",
    "verify:generated": "node scripts/verify-generated.mjs",
    "verify:native": "node scripts/verify-native-ledger.mjs",
    "verify:wasm": "node scripts/verify-wasm-ledger.mjs"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
